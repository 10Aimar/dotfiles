key_source = "secret-service"

[system.monitor]
cpu_poll_seconds = 2.0
cpu_temp_activity_threshold = 60.0
cpu_temp_critical_threshold = 85.0
cpu_temp_sensor_path = ""
cpu_usage_activity_threshold = 50.0
cpu_usage_critical_threshold = 90.0
disk_free_activity_threshold = 80.0
disk_free_critical_threshold = 95.0
disk_free_pct_activity_threshold = 80.0
disk_free_pct_critical_threshold = 95.0
disk_poll_seconds = 0.0
disk_used_activity_threshold = 80.0
disk_used_critical_threshold = 95.0
disk_used_pct_activity_threshold = 80.0
disk_used_pct_critical_threshold = 95.0
enabled = true
gpu_poll_seconds = 5.0
gpu_temp_activity_threshold = 60.0
gpu_temp_critical_threshold = 85.0
gpu_usage_activity_threshold = 50.0
gpu_usage_critical_threshold = 95.0
gpu_vram_activity_threshold = 50.0
gpu_vram_critical_threshold = 90.0
memory_poll_seconds = 2.0
net_rx_activity_threshold = 1.0
net_rx_critical_threshold = 50.0
net_tx_activity_threshold = 1.0
net_tx_critical_threshold = 50.0
network_poll_seconds = 3.0
ram_pct_activity_threshold = 60.0
ram_pct_critical_threshold = 90.0
swap_pct_activity_threshold = 20.0
swap_pct_critical_threshold = 80.0

[theme]
builtin = "Tokyo-Night"
community_palette = "Catppuccin Macchiato Pink"
custom_palette = ""
mode = "dark"
pure_black_dark = false
source = "community"
wallpaper_scheme = "soft"

    [theme.templates]
    builtin_ids = [ "gtk3", "gtk4", "kcolorscheme", "niri", "qt", "starship" ]
    community_ids = [ "spicetify", "pywalfox", "vscode", "steam" ]
    enable_builtin_templates = true
    enable_community_templates = true

[wallpaper]
directory = ""
directory_dark = ""
directory_light = ""
edge_smoothness = 0.30000001192092896
enabled = true
fill_color = ""
fill_mode = "crop"
per_monitor_directories = false
transition = [ "disc", "honeycomb", "stripes" ]
transition_duration = 1500.0
transition_on_startup = true

    [wallpaper.automation]
    enabled = false
    interval_seconds = 1800
    order = "random"
    recursive = true

[weather]
effects = true
enabled = true
refresh_minutes = 30
unit = "metric"

[widget.active_window]
icon_size = 14.0
max_length = 260.0
min_length = 80.0
title_scroll = "none"
type = "active_window"

[widget.clock]
font_weight = 1000
scale = 1.1000000000000001
type = "clock"

[widget.cpu]
display = "text"
glyph = "cpu-temperature"
stat = "cpu_temp"
type = "sysmon"

[widget.date]
format = "{:%a %d %b}"
type = "clock"

[widget.input_volume]
device = "input"
type = "volume"

[widget.keyboard_layout]
hide_when_single_layout = false
type = "keyboard_layout"

[widget.launcher]
color = "tertiary"
custom_image = "/usr/share/noctalia/assets/noctalia.svg"
scale = 1.5
type = "launcher"

[widget.lock_keys]
display = "short"
hide_when_off = false
show_caps_lock = true
show_num_lock = true
show_scroll_lock = false
type = "lock_keys"

[widget.media]
art_size = 16.0
capsule_border = "error"
hide_when_no_media = true
max_length = 220.0
min_length = 80.0
title_scroll = "on_hover"
type = "media"

    [widget.media.actions]
    scroll_down = "exec ~/.local/bin/spotify-volume down"
    scroll_up = "exec ~/.local/bin/spotify-volume up"

[widget.network]
show_label = false
type = "network"

[widget.network_rx]
stat = "net_rx"
type = "sysmon"

[widget.network_tx]
stat = "net_tx"
type = "sysmon"

[widget.output_volume]
device = "output"
type = "volume"

[widget.ram]
stat = "ram_used"
type = "sysmon"

[widget.session]
capsule = true
color = "error"
type = "session"

[widget.spacer]
type = "spacer"

[widget.sysmon]
display = "text"
glyph = "gpu-usage"
stat = "gpu_temp"
type = "sysmon"

[widget.temp]
display = "text"
glyph = "cpu"
stat = "gpu_temp"
type = "sysmon"

[widget.tray]
drawer = true
drawer_item_size = 20.0
pinned = [ "steam", "coolercontrol" ]
scale = 1.2
type = "tray"

[widget.volume]
show_label = false
type = "volume"

[widget.wallpaper]
scale = 1.3
type = "wallpaper"

[widget.workspaces]
capsule_border = "tertiary"
hide_when_empty = true
type = "workspaces"
