[accessibility]
high_contrast = false
ui_scale = 1.0

[audio]
enable_overdrive = false
enable_sounds = false
notification_sound = ""
sound_volume = 0.5
volume_change_sound = ""

[backdrop]
blur_intensity = 0.5
enabled = false
tint_intensity = 0.30000001192092896

[bar]
order = [ "MainBar" ]

    [bar.MainBar]
    auto_hide = false
    background_opacity = 0.0
    border = "primary"
    border_width = 1.5
    capsule = false
    capsule_fill = "surface_variant"
    capsule_group = []
    capsule_opacity = 1.0
    capsule_padding = 6.0
    capsule_thickness = 0.75999999046325684
    center = [ "clock" ]
    concave_edge_corners = false
    contact_shadow = false
    enabled = true
    end = [ "cpu", "temp", "tray", "notifications", "clipboard", "network", "bluetooth", "volume", "session" ]
    font_weight = 500
    hover_highlight = true
    layer = "top"
    margin_edge = 0
    margin_ends = 250
    margin_opposite_edge = 0
    padding = 14
    panel_overlap = 1
    position = "top"
    radius = 12
    radius_bottom_left = 12
    radius_bottom_right = 12
    radius_top_left = 12
    radius_top_right = 12
    reserve_space = true
    scale = 1.1000000238418579
    shadow = true
    show_on_workspace_switch = true
    smart_auto_hide = false
    start = [ "launcher", "wallpaper", "workspaces", "media" ]
    thickness = 34
    widget_spacing = 6

        [bar.MainBar.dead_zone.actions]
        middle = "desktop-widgets-edit"
        scroll_down = "exec niri msg action focus-column-right-or-first"
        scroll_up = "exec niri msg action focus-column-left-or-last"

[battery]
warning_threshold = 10

[brightness]
enable_ddcutil = false
ignore_mmids = []
minimum_brightness = 0.0
sync_all_monitors = false

[calendar]
enabled = false
refresh_minutes = 15

[control_center]
hidden_tabs = [ "monitor" ]
sidebar = "compact"
sidebar_section = "none"
width = 700

    [control_center.calendar]
    event_date_format = "%A %e %B"
    event_time_format = "%H:%M"
    show_events_card = true
    show_week_numbers = false

    [[control_center.shortcuts]]
