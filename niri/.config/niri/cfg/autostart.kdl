// Add lines like this to spawn processes at startup.
// Note that running niri as a session supports xdg-desktop-autostart,
// which may be more convenient to use.
// See the binds section below for more spawn examples.


// This line starts waybar, a commonly used bar for Wayland compositors.
//spawn-at-startup "waybar"

// Workspaces setup
workspace "󰝚"
workspace ""
workspace "" //""
workspace "󰖟"
workspace ""
workspace ""
workspace "󰆍"

spawn-at-startup "niri" "msg" "action" "focus-workspace" "󰖟"

// 4 Kwallet seemless login
spawn-at-startup "/usr/libexec/pam_kwallet_init"

// Noctalia V5
spawn-at-startup "noctalia"

// Daemon 4 tray compatibility 4 battle net
// spawn-at-startup "xembedsniproxy"

//Syncathing -command4tray: flatpak override --user --env=XDG_CURRENT_DESKTOP=KDE com.github.zocker_160.SyncThingy
// already on kde //spawn-at-startup "flatpak" "run" "--command=SyncThingy" "com.github.zocker_160.SyncThingy" "--no-browser"

// Spotify

spawn-sh-at-startup "sleep 10 && flatpak run com.spotify.Client"

// Steam
spawn-sh-at-startup "sleep 14 && /usr/bin/steam -silent"

// To run a shell command (with variables, pipes, etc.), use spawn-sh-at-startup:
// spawn-sh-at-startup "qs -c ~/source/qs/MyAwesomeShell"

hotkey-overlay {
    // Uncomment this line to disable the "Important Hotkeys" pop-up at startup.
    skip-at-startup
}

// 🎮 Gaming
//
//     󰊗 — gamepad
//
//      — gamepad
//
//     󰺵 — joystick-ish / games
//
//     󰓓 — controller
//
//      — Steam
//
//     󰙯 — could work for gaming/social, depending on your setup
//
// 🎵 Music / media
//
//     󰝚 — music note
//
//     󰎈 — music
//
//      — headphones
//
//     󰓃 — speaker
//
//     󰕾 — volume/speaker
//
//      — audio
//
//     󰗲 — video/media
//
//      — film
//
//     󰟞 — movie
//
//      — play button
//
//     󰐊 — play
//
//     󰑈 — playlist
//
// 📺 General entertainment
//
//     󰐊 — playback
//
//      — video camera
//
//      — display/TV
//
//     󰟴 — television
//
//     󰗩 — cinema/movie
//
//     󰖏 — television
//
//      — microphone / recording
//
// 💻 Development / technical
//
//      — code
//
//      — code
//
//      — programming
//
//      — terminal
//
//     󰆍 — terminal
//
//     󰅩 — tools
//
//     󰒓 — settings/config
//
//     󰘳 — database
//
//     󰌛 — bug/debugging
//
//     󰏗 — package/build
//
// 🌐 Browsing / internet
//
//     󰖟 — web
//
//      — globe
//
//     󰇧 — network
//
//     󰒍 — browser-ish
//
//      — Firefox
//
//      — Chrome/Chromium
//
//      — web/dev
//
// 📁 Files / documents
//
//     󰉋 — folder
//
//      — folder
//
//     󰈙 — document
//
//      — document
//
//     󰈬 — file search
//
//     󰏢 — archive/storage
//
//     󰋩 — books/documents
