// Window rules: adjust behavior for individual apps.
// https://niri-wm.github.io/niri/Configuration:-Window-Rules

// Work around WezTerm's initial configure bug.
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

// Open Firefox picture-in-picture as floating.
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Example: block password managers from screen capture (disabled).
/-window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#
    block-out-from "screen-capture"
}

// Example: rounded corners for all windows (disabled, superseded by noctalia's rule).
/-window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}
//---------------------------------------------

//      My Edits

//--Browsers--

// Firefox
window-rule {
    match app-id=r#"firefox$"#
    open-maximized true
    open-on-workspace "󰖟"
}

// Brave
window-rule {
    match app-id="brave-browser"
    open-maximized true
    open-on-workspace "󰖟"
}

//---------------------------------------------

//--KDE Apps--

// Kwrite
window-rule {
    match app-id="org.kde.kwrite"
    open-on-workspace ""
}

// Dolphin
window-rule {
    match app-id="org.kde.dolphin"
    open-on-workspace ""
}

//---------------------------------------------

//--Gaming--

// Steam App
window-rule {
    match app-id="steam" title="Steam"
    open-maximized true
    open-on-workspace ""
    }

// VRR for Steam Games
window-rule {
    match app-id=r#"^steam_app_[0-9]+$"#
    open-on-workspace ""
    variable-refresh-rate true
    }

// Hearthstone
window-rule {
    match app-id="steam_app_default" title="Hearthstone"
    open-on-workspace ""
    open-maximized true
    variable-refresh-rate true
}
// Battle.net
window-rule {
    match app-id="steam_app_default" title="Battle.net"
    default-floating-position x=235 y=15 relative-to="top-right"
    open-floating true
    open-focused false
}

//---------------------------------------------

//--Music--

// Spotify always opens on the left monitor (Samsung TV).
window-rule {
     match app-id="spotify"
     // open-on-output "HDMI-A-1"
     open-on-workspace "󰝚"
     open-maximized true
     open-focused false
}

//---------------------------------------------

//--TV Media--

//  Netflix - Brave PWA
window-rule {
    match app-id="brave-eppojlglocelodeimnohnlnionkobfln-Default"
    open-on-workspace ""
    open-maximized true
}

// NOS TV - Brave PWA
window-rule {
    match app-id="brave-pnghkaloolpocgfpndmjfbhpjffdmdii-Default"
    open-on-workspace ""
    // open-on-output "HDMI-A-1"
    open-maximized true
}

// Stremio
window-rule {
    match app-id="com.stremio.Stremio"
    open-on-workspace ""
    open-maximized true
}

//---------------------------------------------

//-- Miscellaneous

// Thunderbird
window-rule {
    match app-id="net.thunderbird.Thunderbird"
    open-on-workspace ""
    open-maximized true
}

