layout {

    focus-ring {
        active-color   "#f28987"
        inactive-color "#291414"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#f28987"
        inactive-color "#291414"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#f28987"
        inactive-color "#b61410"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#f2898780"
    }
}

recent-windows {
    highlight {
        active-color "#f28987"
        urgent-color "#fd4663"
    }
}
